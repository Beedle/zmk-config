#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include "keys_nb.h"


&mt {
    tapping-term-ms = <250>;
    flavor = "tap-preferred";
};

/ {

    conditional_layers {
        compatible = "zmk,conditional-layers";

        five_one_plus_two_layer {
            if-layers = <1 2>;
            then-layer = <5>;
        };

        six_three_plus_four_layer {
            if-layers = <3 4>;
            then-layer = <6>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
                &kp ESC             &kp NB_PIPE                                                                                                                                                                                                                                     &kp DELETE                  &kp BACKSPACE
                &kp TAB             &kp NB_Q            &kp NB_W        &kp NB_E            &kp NB_R            &kp NB_T        &kp NB_LEFT_PARENTHESIS                                 &kp NB_RIGHT_PARENTHESIS &kp NB_Y   &kp NB_U            &kp NB_I            &kp NB_O        &kp NB_P                    &kp NB_A_RING
                &kp CAPSLOCK        &mt LSHFT NB_A      &mt LCTRL NB_S  &mt LMETA NB_D      &mt LALT NB_F       &kp NB_G        &kp NB_LEFT_BRACE                                       &kp NB_RIGHT_BRACE       &kp NB_H   &mt RALT NB_J       &mt RMETA NB_K      &mt RCTRL NB_L  &mt RSHFT NB_O_SLASH        &kp NB_AE
                &kp NB_LESS_THAN    &kp NB_Z            &kp NB_X        &kp NB_C            &kp NB_V            &kp NB_B        &kp NB_DOUBLE_QUOTES                                    &kp NB_SEMICOLON         &kp NB_N   &kp NB_M            &kp COMMA           &kp DOT         &kp NB_MINUS                &kp RSHFT
                                                                                                                                                        &mo 3               &mo 4
                                                                        &kp LSHFT           &kp LCTRL           &kp LMETA       &mo 1                   &kp RET             &kp SPACE   &mo 2                    &kp RMETA  &kp RCTRL           &kp RSHFT
            >;
        };

        one_layer {
            display-name = "L1";
            bindings = <
                &trans              &trans                                                                                                                                                                                                                                          &trans                      &trans
                &trans              &kp NB_CARET        &kp NB_N1       &kp NB_N2           &kp NB_N3           &kp NB_N4       &kp NB_N5                                               &kp NB_N6               &kp NB_N7   &kp NB_N8           &kp NB_N9           &kp NB_N0       &kp NB_CURRENCY_SIGN        &trans
                &trans              &kp NB_POUND_SIGN   &kp NB_PERCENT  &kp NB_EQUAL        &kp NB_UNDERSCORE   &kp NB_LESS_THAN &kp NB_LEFT_BRACKET                                    &kp NB_RIGHT_BRACKET &kp NB_GREATER_THAN &kp NB_SLASH   &kp NB_BACKSLASH   &kp NB_AMPERSAND &kp NB_BROKEN_PIPE          &trans
                &trans              &kp NB_HASH         &kp NB_TILDE    &kp NB_DOLLAR       &kp NB_MINUS        &kp NB_PLUS     &kp NB_SINGLE_QUOTE                                     &kp NB_COLON       &kp NB_SEMICOLON &kp NB_PIPE         &kp NB_QUESTION  &kp NB_EXCLAMATION &kp NB_SECTION              &trans
                                                                                                                                                        &trans              &trans
                                                                        &trans              &trans              &trans          &trans                  &kp SPACE           &kp RET     &trans                  &trans      &trans              &trans
            >;
        };

        two_layer {
            display-name = "R1";
            bindings = <
                &trans              &trans                                                                                                                                                                                                                                          &trans                      &trans
                &trans              &kp F1              &kp F2          &kp F3              &kp F4              &kp F5          &kp F6                                                  &kp F7                  &kp F8      &kp F9              &kp F10             &kp F11         &kp F12                     &trans
                &trans              &kp LSHFT           &kp LCTRL       &kp LMETA           &kp LALT            &trans          &kp INS                                                 &kp PSCRN               &trans      &kp RALT            &kp RMETA           &kp RCTRL       &kp RSHFT                   &trans
                &trans              &trans              &trans          &trans              &trans              &trans          &kp KP_NUMLOCK                                          &kp SCROLLLOCK          &trans      &trans              &trans              &trans          &trans                      &trans
                                                                                                                                                        &trans              &trans
                                                                        &trans              &trans              &trans          &trans                  &kp SPACE           &kp RET     &trans                  &trans      &trans              &trans
            >;
        };

        three_layer {
            display-name = "L2";
            bindings = <
                &trans              &trans                                                                                                                                                                                                                                          &trans                      &trans
                &trans              &trans              &trans          &trans              &trans              &kp UP          &trans                                                  &trans                  &trans      &trans              &trans              &trans          &trans                      &trans
                &trans              &trans              &trans          &trans              &kp LEFT            &kp DOWN        &kp RIGHT                                               &trans                  &trans      &trans              &trans              &trans          &trans                      &trans
                &trans              &trans              &trans          &trans              &trans              &trans          &trans                                                  &trans                  &trans      &trans              &trans              &trans          &trans                      &trans
                                                                                                                                                        &trans              &trans
                                                                        &trans              &trans              &trans          &trans                  &trans              &trans      &trans                  &trans      &trans              &trans
            >;
        };

        four_layer {
            display-name = "R2";
            bindings = <
                &trans              &trans                                                                                                                                                                                                                                          &trans                      &trans
                &trans              &trans              &trans          &trans              &trans              &kp PG_UP       &trans                                                  &kp KP_N7               &kp KP_N8   &kp KP_N9           &kp KP_MINUS        &trans          &trans                      &trans
                &trans              &trans              &trans          &trans              &kp HOME            &kp PG_DN       &kp END                                                 &kp KP_N4               &kp KP_N5   &kp KP_N6           &kp KP_PLUS         &trans          &trans                      &trans
                &trans              &trans              &trans          &trans              &trans              &trans          &trans                                                  &kp KP_N1               &kp KP_N2   &kp KP_N3           &kp KP_N0           &trans          &trans                      &trans
                                                                                                                                                        &trans              &trans
                                                                        &trans              &trans              &trans          &trans                  &trans           &kp KP_NUMLOCK &kp KP_SLASH            &kp KP_ASTERISK &trans          &kp KP_ENTER
            >;
        };

        five_one_plus_two_layer {
            display-name = "LR1";
            bindings = <
                &trans              &trans                                                                                                                                                                                                                                          &trans                      &trans
                &trans              &trans              &trans          &trans              &kp K_PLAY_PAUSE    &kp K_VOL_UP    &kp K_MUTE                                              &trans                  &trans      &trans              &trans              &trans          &trans                      &trans
                &trans              &trans              &trans          &trans              &kp K_PREV          &kp K_VOL_DN    &kp K_NEXT                                              &trans                  &trans      &trans              &trans              &trans          &trans                      &trans
                &trans              &trans              &trans          &trans              &trans              &trans          &trans                                                  &trans                  &trans      &trans              &trans              &trans          &trans                      &trans
                                                                                                                                                        &trans              &trans
                                                                        &trans              &trans              &trans          &trans                  &trans              &trans      &trans                  &trans      &trans              &trans
            >;
        };

        six_three_plus_four_layer {
            display-name = "LR2";
            bindings = <
                &bt BT_CLR          &trans                                                                                                                                                                                                                                          &trans                      &trans
                &bt BT_SEL 0        &bt BT_SEL 1        &bt BT_SEL 2    &bt BT_SEL 3        &bt BT_SEL 4        &kp UP          &trans                                                  &trans                  &trans      &trans              &trans              &trans          &trans                      &trans
                &trans              &trans              &trans          &trans              &trans              &trans          &trans                                                  &trans                  &trans      &trans              &trans              &trans          &trans                      &trans
                &trans              &trans              &trans          &trans              &trans              &trans          &trans                                                  &trans                  &trans      &trans              &trans              &trans          &trans                      &trans
                                                                                                                                                        &trans              &trans
                                                                        &trans              &trans              &trans          &trans                  &trans              &trans      &trans                  &trans      &trans              &trans
            >;
        };
    };
};
